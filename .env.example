# Embedding（P2 起需要；只放服务端，勿用 NEXT_PUBLIC_）
# DeepSeek 聊天 Key 不能用于 Embedding。

# --- 硅基流动（推荐）---
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=https://api.siliconflow.cn/v1
EMBEDDING_MODEL=BAAI/bge-m3

# --- 或 OpenAI 官方（不要同时填两套）---
# EMBEDDING_API_KEY=sk-xxxx
# EMBEDDING_MODEL=text-embedding-3-small
# （官方可不写 EMBEDDING_BASE_URL）

# --- P4 问答（流式生成）---
# 聊天 Key，可复用 01-chatbot 的 DeepSeek Key（与 Embedding 是不同能力）
DEEPSEEK_API_KEY=
# 可选：deepseek-v4-flash（默认，对应旧 deepseek-chat）或 deepseek-v4-pro
# DEEPSEEK_MODEL=deepseek-v4-flash

# --- P5 Postgres + pgvector（存储升级）---
# 本地可用 docker compose up -d 启动（见 docker-compose.yml）
# 宿主端口用 5433（5432 可能被其他项目占用）
DATABASE_URL=postgres://rag:rag@localhost:5433/rag_kb
